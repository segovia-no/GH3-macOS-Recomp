# SwARc lifter manifest for GH3.exe (PC 1.3.1 with the GH3+ loader and the HATRED section).
# Directives: entry|name|resume|setjmp|probe|replace <va> [name]
# Function list comes from Ghidra (build/symbols/gh3/functions.tsv); this file
# holds overrides found while lifting and running; scripts/dev/gen_manifest.py
# merges it with the extracted names into manifests/lifter.manifest.

name 0068f03c entry_point
replace 00897d40 gh3plus_load_core_dll

# Constants the pointer scan took for code (outside Ghidra's blocks, so
# scripts/dev/find_false_entries.py cannot see them).
noentry 007fffff

# CPU skinning of character meshes: native (src/skinning.cpp); the
# lifted body stays as f_0061C590_lifted (GH3_VERIFY_SKIN=1 compares them).
replace 0061c590 skin_vertices
