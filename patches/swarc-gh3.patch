+// four-colour palette of the same endpoints.
+void Dxt1ToDxt3Block(const uint8_t* in, uint8_t* out) {
+  uint16_t c0 = uint16_t(in[0] | in[1] << 8), c1 = uint16_t(in[2] | in[3] << 8);
