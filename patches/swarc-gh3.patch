+    }
+    uint64_t bits = 0;
+    for (int i = 0; i < 6; i++) bits |= uint64_t(blk[2 + i]) << (8 * i);
+    for (int i = 0; i < 16; i++)
+      px[i] = (px[i] & 0xFFFFFF) | uint32_t(ap[(bits >> (3 * i)) & 7]) << 24;
+  }
+}
