+    std::memcpy(row, src + ptrdiff_t(y) * src_stride, size_t(bytes));
+    if (width > bytes) std::memset(row + bytes, pad, size_t(width - bytes));
+  }
+  for (int y = rows; y < alloc_h; y++)
+    std::memset(GPtr(buf + uint32_t(y) * pitch), pad, size_t(width));
