+      uint32_t al = (blk[i / 2] >> (4 * (i & 1))) & 0xF;
+      px[i] = (px[i] & 0xFFFFFF) | (al * 0x11) << 24;
+    }
+  } else if (fmt == D3DFMT_DXT4 || fmt == D3DFMT_DXT5) {
+    int a0 = blk[0], a1 = blk[1], ap[8];
