+    ap[1] = a1;
+    if (a0 > a1) {
+      for (int k = 1; k < 7; k++) ap[k + 1] = ((7 - k) * a0 + k * a1) / 7;
+    } else {
+      for (int k = 1; k < 5; k++) ap[k + 1] = ((5 - k) * a0 + k * a1) / 5;
+      ap[6] = 0;
