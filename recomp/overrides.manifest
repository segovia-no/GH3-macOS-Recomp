# SwARc lifter manifest for GH3.exe (BetterGH3 build, HATRED-unwrapped).
# Directives: entry|name|resume|setjmp|probe|replace <va> [name]
# Function list comes from Ghidra (work/symbols/functions.tsv); this file
# holds overrides found while lifting and running; tools/gen_manifest.py
# merges it with the extracted names into recomp/lifter.manifest.

name 0068f03c entry_point
replace 00897d40 gh3plus_load_core_dll

# Constants the pointer scan took for code (outside Ghidra's blocks, so
# tools/find_false_entries.py cannot see them).
noentry 007fffff
